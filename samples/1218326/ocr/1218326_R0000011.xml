<OCRDATASET>
<PAGE IMAGENAME="1218326_R0000011.jpg" WIDTH="4504" HEIGHT="4592">
  <TEXTBLOCK CONF="0.933">
    <LINE TYPE="タイトル本文" X="2851" Y="1012" WIDTH="67" HEIGHT="370" CONF="0.935" PRED_CHAR_CNT="3.000" ORDER="0" STRING="凡例" />
  <SHAPE><POLYGON POINTS="2851,1012,2851,1382,2918,1382,2918,1012" /></SHAPE>
    </TEXTBLOCK>
  <TEXTBLOCK CONF="0.985">
    <LINE TYPE="本文" X="2680" Y="726" WIDTH="68" HEIGHT="1555" CONF="0.952" PRED_CHAR_CNT="2.000" ORDER="1" STRING="一、本書は現今臺灣に於て行はるゝ厦門語系の言語" />
    <LINE TYPE="本文" X="2564" Y="781" WIDTH="64" HEIGHT="1492" CONF="0.952" PRED_CHAR_CNT="2.000" ORDER="2" STRING="につき、最も普通なるもの、約九萬餘言を採り、之に" />
    <LINE TYPE="本文" X="2456" Y="774" WIDTH="58" HEIGHT="941" CONF="0.942" PRED_CHAR_CNT="3.000" ORDER="3" STRING="國語の對譯を施せるものなり。" />
    <LINE TYPE="本文" X="2329" Y="723" WIDTH="72" HEIGHT="1553" CONF="0.950" PRED_CHAR_CNT="2.000" ORDER="4" STRING="一、本書に於て採用せる語音は主として厦門音を標" />
    <LINE TYPE="本文" X="2213" Y="775" WIDTH="67" HEIGHT="1503" CONF="0.949" PRED_CHAR_CNT="2.000" ORDER="5" STRING="準とせり、此れ厦門音は津州音、泉州音の中間に位" />
    <LINE TYPE="本文" X="2096" Y="777" WIDTH="69" HEIGHT="1498" CONF="0.954" PRED_CHAR_CNT="2.000" ORDER="6" STRING="し、二者の特質を併有するを以てなり、然れども淨" />
    <LINE TYPE="本文" X="1982" Y="775" WIDTH="67" HEIGHT="1498" CONF="0.954" PRED_CHAR_CNT="2.000" ORDER="7" STRING="州、泉州其他に於て特別の音を有するものは又成" />
    <LINE TYPE="本文" X="1875" Y="780" WIDTH="55" HEIGHT="642" CONF="0.937" PRED_CHAR_CNT="3.000" ORDER="8" STRING="るべく之を採録せり。" />
    <LINE TYPE="本文" X="1752" Y="722" WIDTH="66" HEIGHT="1548" CONF="0.943" PRED_CHAR_CNT="2.000" ORDER="9" STRING="一、語音中、五十音字を以て表はすこと能はざるもの" />
    <LINE TYPE="本文" X="1635" Y="776" WIDTH="64" HEIGHT="1500" CONF="0.953" PRED_CHAR_CNT="2.000" ORDER="10" STRING="は別に符號字、及び符號を作りて之を表はせり。而" />
    <LINE TYPE="本文" X="1521" Y="776" WIDTH="64" HEIGHT="1495" CONF="0.948" PRED_CHAR_CNT="2.000" ORDER="11" STRING="して其の詳細は別に臺灣語の發音の部に解説せ" />
    <LINE TYPE="本文" X="1431" Y="775" WIDTH="36" HEIGHT="67" CONF="0.829" PRED_CHAR_CNT="3.000" ORDER="12" STRING="り。" />
  <LINE TYPE="本文" X="1288" Y="721" WIDTH="65" HEIGHT="1551" CONF="0.943" PRED_CHAR_CNT="2.000" ORDER="13" STRING="一、語詞の排列は大體五十音の順序によれりと雖も、" />
    <LINE TYPE="本文" X="1172" Y="773" WIDTH="63" HEIGHT="1497" CONF="0.954" PRED_CHAR_CNT="2.000" ORDER="14" STRING="出氣音は基本の假名に併屬し、符號假名は基本の" />
    <LINE TYPE="本文" X="1056" Y="771" WIDTH="64" HEIGHT="1503" CONF="0.947" PRED_CHAR_CNT="2.000" ORDER="15" STRING="假名の次に出せり(別紙索引表參照)、尙同一の假名" />
    <LINE TYPE="本文" X="939" Y="770" WIDTH="64" HEIGHT="1501" CONF="0.948" PRED_CHAR_CNT="2.000" ORDER="16" STRING="を有する語詞にして音調又は常音、鼻音の相違あ" />
    <LINE TYPE="本文" X="822" Y="775" WIDTH="66" HEIGHT="1500" CONF="0.953" PRED_CHAR_CNT="2.000" ORDER="17" STRING="る場合は、鼻音は常音の次に出し、音調は八聲の順" />
    <SHAPE><POLYGON POINTS="824,724,824,2282,2750,2282,2750,724" /></SHAPE>
    </TEXTBLOCK>
  <TEXTBLOCK CONF="0.985">
    <LINE TYPE="本文" X="2912" Y="2484" WIDTH="53" HEIGHT="357" CONF="0.920" PRED_CHAR_CNT="3.000" ORDER="18" STRING="序によれり。" />
    <LINE TYPE="本文" X="2785" Y="2437" WIDTH="66" HEIGHT="1548" CONF="0.950" PRED_CHAR_CNT="2.000" ORDER="19" STRING="一、臺灣語を表はす漢字は大體從來慣用のものを用" />
    <LINE TYPE="本文" X="2673" Y="2491" WIDTH="60" HEIGHT="1491" CONF="0.942" PRED_CHAR_CNT="2.000" ORDER="20" STRING="ひたれども語原的に根據ありと認めたるものは" />
    <LINE TYPE="本文" X="2554" Y="2484" WIDTH="65" HEIGHT="1502" CONF="0.952" PRED_CHAR_CNT="2.000" ORDER="21" STRING="之に相當する文字を充用し、而して其の用法は務" />
    <LINE TYPE="本文" X="2441" Y="2491" WIDTH="62" HEIGHT="1491" CONF="0.947" PRED_CHAR_CNT="2.000" ORDER="22" STRING="めて統一を期せり。又適當なる漢字なき場合は、其" />
    <LINE TYPE="本文" X="2324" Y="2490" WIDTH="61" HEIGHT="1489" CONF="0.950" PRED_CHAR_CNT="2.000" ORDER="23" STRING="の意義に拘はらず同音又は類音の漢字を充用し、" />
    <LINE TYPE="本文" X="2206" Y="2490" WIDTH="64" HEIGHT="1492" CONF="0.947" PRED_CHAR_CNT="2.000" ORDER="24" STRING="又全く漢字を充つること能はざる場合は□を用" />
    <LINE TYPE="本文" X="2097" Y="2485" WIDTH="54" HEIGHT="570" CONF="0.936" PRED_CHAR_CNT="3.000" ORDER="25" STRING="ひて之を表はせり。" />
    <LINE TYPE="本文" X="1976" Y="2433" WIDTH="62" HEIGHT="1547" CONF="0.947" PRED_CHAR_CNT="2.000" ORDER="26" STRING="一、成句、俚諺及び格言にして普通に行はるゝものは" />
    <LINE TYPE="本文" X="1861" Y="2481" WIDTH="57" HEIGHT="719" CONF="0.938" PRED_CHAR_CNT="3.000" ORDER="27" STRING="成るべく之を採録せり。" />
    <LINE TYPE="本文" X="1743" Y="2430" WIDTH="60" HEIGHT="1548" CONF="0.948" PRED_CHAR_CNT="2.000" ORDER="28" STRING="一、譯語の下には成るべく同意語を擧げ應用の便に" />
    <LINE TYPE="本文" X="1638" Y="2480" WIDTH="52" HEIGHT="287" CONF="0.926" PRED_CHAR_CNT="3.000" ORDER="29" STRING="供したり。" />
    <LINE TYPE="本文" X="1517" Y="2434" WIDTH="57" HEIGHT="1551" CONF="0.947" PRED_CHAR_CNT="2.000" ORDER="30" STRING="一、同一の語にして其の意義を異にするものは●●" />
    <LINE TYPE="本文" X="1400" Y="2483" WIDTH="57" HEIGHT="1080" CONF="0.943" PRED_CHAR_CNT="3.000" ORDER="31" STRING="の如き記號を用ひて之を區別せり。" />
    <LINE TYPE="本文" X="1279" Y="2429" WIDTH="62" HEIGHT="1546" CONF="0.949" PRED_CHAR_CNT="2.000" ORDER="32" STRING="一、例語、例句の場合に於て其の條の本語に相當する" />
    <LINE TYPE="本文" X="1166" Y="2480" WIDTH="60" HEIGHT="1156" CONF="0.947" PRED_CHAR_CNT="3.000" ORDER="33" STRING="所は(-)の記號を用ひて之を表はせり。" />
    <LINE TYPE="本文" X="1049" Y="2430" WIDTH="62" HEIGHT="1548" CONF="0.950" PRED_CHAR_CNT="2.000" ORDER="34" STRING="一、語詞、又は譯語の下には〕を施せるは同意語を示" />
    <LINE TYPE="本文" X="944" Y="2478" WIDTH="48" HEIGHT="67" CONF="0.897" PRED_CHAR_CNT="3.000" ORDER="35" STRING="す。" />
  <LINE TYPE="本文" X="816" Y="2425" WIDTH="61" HEIGHT="1549" CONF="0.949" PRED_CHAR_CNT="2.000" ORDER="36" STRING="一、漢字の間に(-)を施せるは上に來る音の轉調する" />
    <SHAPE><POLYGON POINTS="818,2424,818,3990,2972,3990,2972,2424" /></SHAPE>
    </TEXTBLOCK>
  <BLOCK TYPE="ノンブル" X="855" Y="568" WIDTH="21" HEIGHT="33" CONF="0.615" />
